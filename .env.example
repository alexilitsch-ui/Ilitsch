# Скопируйте этот файл в .env и впишите свои ключи.

# Ключ ИИ Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Токен Telegram-бота (нужен только для режима telegram): получите у @BotFather
TELEGRAM_BOT_TOKEN=

# Необязательно: модель ИИ и глубина размышлений (low / medium / high)
# ORACLE_MODEL=claude-opus-5-5
# ORACLE_EFFORT=medium
